{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DPREPARE_ENV=ON",
                "-DBUILD_THIRD_PARTY=ON"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-NonInteractive",
                "-File", "${workspaceFolder}/Scripts/BuildWin.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "CMake: Build Engine",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--config", "RelWithDebInfo",
                "--target", "InnocenceEngine",
                "-j"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": "CMake: Configure",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "CMake: Build Editor",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--config", "RelWithDebInfo",
                "--target", "Editor",
                "-j"
            ],
            "group": "build",
            "dependsOn": "CMake: Configure",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Test: TestSuite",
            "type": "shell",
            "command": "${workspaceFolder}/Bin/RelWithDebInfo/TestSuite.exe",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}/Bin"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: RenderTest draw_instanced",
            "type": "shell",
            "command": "${workspaceFolder}/Bin/RelWithDebInfo/RenderTest.exe",
            "args": ["-mode", "0", "-renderer", "0", "-loglevel", "0", "-offscreen", "-test", "draw_instanced"],
            "options": {
                "cwd": "${workspaceFolder}/Bin"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: RenderTest pixel_readback",
            "type": "shell",
            "command": "${workspaceFolder}/Bin/RelWithDebInfo/RenderTest.exe",
            "args": ["-mode", "0", "-renderer", "0", "-loglevel", "0", "-offscreen", "-test", "pixel_readback"],
            "options": {
                "cwd": "${workspaceFolder}/Bin"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: All",
            "dependsOn": [
                "Test: TestSuite",
                "Test: RenderTest draw_instanced",
                "Test: RenderTest pixel_readback"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
