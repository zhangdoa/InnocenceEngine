{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-NonInteractive",
                "-File", "${workspaceFolder}/Scripts/BuildWin.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Test: TestSuite",
            "type": "shell",
            "command": "${workspaceFolder}/Bin/RelWithDebInfo/TestSuite.exe",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}/Bin"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: RenderTest draw_instanced",
            "type": "shell",
            "command": "${workspaceFolder}/Bin/RelWithDebInfo/RenderTest.exe",
            "args": ["-mode", "0", "-renderer", "0", "-loglevel", "0", "-offscreen", "-test", "draw_instanced"],
            "options": {
                "cwd": "${workspaceFolder}/Bin"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: RenderTest pixel_readback",
            "type": "shell",
            "command": "${workspaceFolder}/Bin/RelWithDebInfo/RenderTest.exe",
            "args": ["-mode", "0", "-renderer", "0", "-loglevel", "0", "-offscreen", "-test", "pixel_readback"],
            "options": {
                "cwd": "${workspaceFolder}/Bin"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: Interactive (full)",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-File", "${workspaceFolder}/Scripts/InteractiveTest.ps1", "-Scenario", "full"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": false },
            "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "Test: Interactive (path tracer toggle)",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-File", "${workspaceFolder}/Scripts/InteractiveTest.ps1", "-Scenario", "toggle_pathtracer"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": false },
            "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "Test: Interactive (path tracer + reload)",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-File", "${workspaceFolder}/Scripts/InteractiveTest.ps1", "-Scenario", "pathtracer_reload"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": false },
            "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "Test: All",
            "dependsOn": [
                "Test: TestSuite",
                "Test: RenderTest draw_instanced",
                "Test: RenderTest pixel_readback",
                "Test: Interactive (full)"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
