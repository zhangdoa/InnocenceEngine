# clangd project config. Scripts/RegenClangdIndex.ps1 emits the real
# flags into compile_commands.json; the entries below force MSVC parser
# compatibility on top of that so lambda → std::function conversions
# and SFINAE patterns parse the same way they do under cl.exe.
CompileFlags:
  Add:
    - -fms-compatibility
    - -fms-extensions
    - -fdelayed-template-parsing
    - -Wno-microsoft
  CompilationDatabase: .
