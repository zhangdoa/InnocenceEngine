# clangd project config. compile_commands.json (regenerated by
# Scripts/RegenClangdIndex.ps1) carries the real flags; this file plugs
# the residual gap where clangd's MSVC-compatibility auto-detection
# misses cases that produce false-positive parser errors on perfectly
# valid MSVC code.
#
# Specifically: lambda → std::function conversions and a few SFINAE
# patterns parse strict-clang differently from MSVC unless we force
# -fms-compatibility / -fdelayed-template-parsing on top of the
# compile_commands.json entry.
CompileFlags:
  Add:
    - -fms-compatibility
    - -fms-extensions
    - -fdelayed-template-parsing
    - -Wno-microsoft
  CompilationDatabase: .
