{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-gate.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/commit-gate.js"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(cmake:*)",
      "Bash(msbuild:*)",
      "Bash(powershell.exe:*)",
      "Bash(cmd.exe:*)",
      "Bash(taskkill.exe:*)",
      "Bash(timeout:*)",
      "Bash(node:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(rm:*)",
      "Bash(wc:*)",
      "Bash(true)",
      "Bash(./RelWithDebInfo/Main.exe:*)",
      "Bash(./RelWithDebInfo/RenderTest.exe:*)",
      "Read(${CLAUDE_PROJECT_DIR}/**)",
      "Write(${CLAUDE_PROJECT_DIR}/.alignments/**)",
      "Edit(${CLAUDE_PROJECT_DIR}/.alignments/**)",
      "Write(${CLAUDE_PROJECT_DIR}/.backlog/**)",
      "Edit(${CLAUDE_PROJECT_DIR}/.backlog/**)",
      "Write(${CLAUDE_PROJECT_DIR}/.claude/**)",
      "Edit(${CLAUDE_PROJECT_DIR}/.claude/**)",
      "Write(${CLAUDE_PROJECT_DIR}/Build/**)",
      "Edit(${CLAUDE_PROJECT_DIR}/Build/**)",
      "Write(${CLAUDE_PROJECT_DIR}/Scripts/**)",
      "Edit(${CLAUDE_PROJECT_DIR}/Scripts/**)",
      "Write(${CLAUDE_PROJECT_DIR}/Source/**)",
      "Edit(${CLAUDE_PROJECT_DIR}/Source/**)",
      "mcp__backlog__task_list",
      "mcp__backlog__task_view",
      "mcp__backlog__task_search",
      "mcp__backlog__task_create",
      "mcp__backlog__task_edit",
      "mcp__backlog__task_complete",
      "mcp__backlog__document_view",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs"
    ],
    "deny": []
  }
}
