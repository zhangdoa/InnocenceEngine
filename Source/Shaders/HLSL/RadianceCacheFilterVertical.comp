// shadertype=hlsl
#include "common/RadianceCacheCommon.hlsl"
#include "RayTracingTypes.hlsl"

struct ComputeInputType
{
    uint3 groupID : SV_GroupID;
    uint3 groupThreadID : SV_GroupThreadID;
    uint3 dispatchThreadID : SV_DispatchThreadID;
    uint groupIndex : SV_GroupIndex;
};

[[vk::binding(0, 0)]]
cbuffer PerFrameConstantBuffer : register(b0)
{
    PerFrame_CB g_Frame;
}

[[vk::binding(0, 1)]]
Texture2D<float4> in_HorizontalFiltered : register(t0);

[[vk::binding(1, 1)]]
Texture2D<float4> in_ProbePosition : register(t1);

[[vk::binding(2, 1)]]
Texture2D<float4> in_ProbeNormal : register(t2);

[[vk::binding(3, 1)]]
Texture2D<uint> in_ProbeMask : register(t3);

[[vk::binding(0, 2)]]
RWTexture2D<float4> out_FinalFiltered : register(u0);

// GI-1.0 Algorithm 5: vertical pass of the separable bilateral filter.
[numthreads(8, 8, 1)]
void main(ComputeInputType input)
{
    uint2 screenCoord = input.dispatchThreadID.xy;
    int2 probeCoord = int2(screenCoord / RADIANCE_CACHE_TILE_SIZE);
    int2 gridSize = int2(uint2(g_Frame.viewportSize.xy) / RADIANCE_CACHE_TILE_SIZE);

    uint currentMask = in_ProbeMask.Load(int3(probeCoord, 0));
    if (!IsValidProbe(currentMask))
    {
        out_FinalFiltered[screenCoord] = float4(0, 0, 0, 0);
        return;
    }

    float3 currentPosWS = in_ProbePosition.Load(int3(probeCoord, 0)).xyz;
    float3 currentNormal = normalize(in_ProbeNormal.Load(int3(probeCoord, 0)).xyz);

    uint2 localCoord = screenCoord % RADIANCE_CACHE_TILE_SIZE;
    float2 octUV = (float2(localCoord) + 0.5) / float(RADIANCE_CACHE_TILE_SIZE);
    float3 sampleDir = DecodeOctahedral(octUV);

    if (dot(sampleDir, currentNormal) <= 0.0)
    {
        out_FinalFiltered[screenCoord] = float4(0, 0, 0, 0);
        return;
    }

    float4 currentRadiance = in_HorizontalFiltered.Load(int3(screenCoord, 0));
    float currentDepth = length(currentPosWS - g_Frame.camera_posWS.xyz);
    float cellSize = max(AdaptiveCellSize(currentDepth, g_Frame.viewportSize.xy, g_Frame.p_original), 0.1);

    static const float weights[7] = { 0.006, 0.061, 0.242, 0.383, 0.242, 0.061, 0.006 };
    static const int offsets[7] = { -3, -2, -1, 0, 1, 2, 3 };

    float4 filteredRadiance = float4(0, 0, 0, 0);
    float totalWeight = 0.0;

    for (int i = 0; i < 7; i++)
    {
        int2 offset = int2(0, offsets[i]);
        int2 sampleCoord = int2(screenCoord) + offset;

        if (any(sampleCoord < int2(0, 0)) || any(sampleCoord >= int2(g_Frame.viewportSize.xy)))
            continue;

        int2 sampleProbeCoord = sampleCoord / int(RADIANCE_CACHE_TILE_SIZE);

        if (any(sampleProbeCoord != probeCoord))
        {
            ProbeLookup neighbor = FindClosestProbe(in_ProbeMask, sampleCoord, int2(0, 0), gridSize);
            if (!IsValidProbe(neighbor.packed))
                continue;

            float3 neighborPosWS = in_ProbePosition.Load(int3(neighbor.tileCoord, 0)).xyz;
            float3 neighborNormal = normalize(in_ProbeNormal.Load(int3(neighbor.tileCoord, 0)).xyz);

            float plane_dist = abs(dot(neighborPosWS - currentPosWS, currentNormal));
            float normal_check = dot(neighborNormal, currentNormal);

            if (plane_dist > cellSize || normal_check < 0.9)
                continue;
        }

        float4 sampleRadiance = in_HorizontalFiltered.Load(int3(sampleCoord, 0));

        float3 sampleProbePos = in_ProbePosition.Load(int3(sampleProbeCoord, 0)).xyz;
        float sampleDepth = length(sampleProbePos - g_Frame.camera_posWS.xyz);
        float depthWeight = 1.0 / (1.0 + abs(currentDepth - sampleDepth) / cellSize);

        float weight = weights[i] * depthWeight;

        filteredRadiance += sampleRadiance * weight;
        totalWeight += weight;
    }

    if (totalWeight > 0.0)
        filteredRadiance /= totalWeight;
    else
        filteredRadiance = currentRadiance;

    filteredRadiance.rgb = max(filteredRadiance.rgb, float3(0.0, 0.0, 0.0));

    out_FinalFiltered[screenCoord] = filteredRadiance;
    DeviceMemoryBarrier();
}
