// shadertype=hlsl
#include "common/common.hlsl"

// Exposure-mode constants must match Inno::ExposureMode in CameraComponent.h.
#define EXPOSURE_MODE_MANUAL 0u
#define EXPOSURE_MODE_AUTO   1u

// Floor for the auto-exposure key K. K = 0 (or denormal/NaN) would push
// maxLuminance through max(EPSILON) and produce an exposure of ~1/EPSILON,
// blowing the frame to white. Per feedback_no_data_integrity_assumptions.md
// we clamp loudly to a sane minimum rather than divide-by-zero silently.
static const float AUTO_EXPOSURE_KEY_MIN = 0.01f;

struct ComputeInputType
{
	uint3 groupID : SV_GroupID;           // 3D index of the thread group in the dispatch.
	uint3 groupThreadID : SV_GroupThreadID;     // 3D index of local thread ID in a thread group.
	uint3 dispatchThreadID : SV_DispatchThreadID;  // 3D index of global thread ID in the dispatch.
	uint  groupIndex : SV_GroupIndex;        // Flattened local index of the thread within a thread group.
};

[[vk::binding(0, 0)]]
cbuffer PerFrameConstantBuffer : register(b0)
{
    PerFrame_CB g_Frame;
}

[[vk::binding(0, 1)]]
Texture2D in_basePassRT0 : register(t0);
[[vk::binding(0, 2)]]
RWStructuredBuffer<float> in_luminanceAverage : register(u0);
[[vk::binding(1, 2)]]
RWTexture2D<float4> out_finalBlendPassRT0 : register(u1);

#include "common/Tonemapping.hlsl"
#include "common/AgX.hlsl"

float ComputeEV100(float aperture, float shutterTime, float ISO)
{
	return log2(aperture * aperture / shutterTime * 100 / ISO);
}

float ComputeEV100FromAvgLuminance(float avgLuminance)
{
	return log2(avgLuminance * 100.0f / 12.5f);
}
float ConvertEV100ToExposure(float EV100)
{
	float maxLuminance = 1.2f * pow(2.0f, EV100);
	return 1.0f / max(maxLuminance, EPSILON);
}

[numthreads(8, 8, 1)]
void main(ComputeInputType input)
{
	float3 basePass = in_basePassRT0[input.dispatchThreadID.xy].xyz;

	// HDR to LDR. Mode + key now data-driven from CameraComponent
	// (TASK-144); see PerFrame_CB.exposureMode / autoExposureKey /
	// autoExposureCompensation. Defaults preserve TASK-142 behavior
	// (Auto mode, K=6.0, no EV bias).
	float exposure;
	if (g_Frame.exposureMode == EXPOSURE_MODE_AUTO)
	{
		// AgX-Default DRT auto-exposure (TASK-141/142). K is the average-luminance
		// scale that maps Y_avg to the tonemap's mid-grey target. Lower K → brighter,
		// higher K → dimmer. K is clamped to AUTO_EXPOSURE_KEY_MIN to keep the
		// exposure denominator finite when scene data is degenerate.
		float K = max(g_Frame.autoExposureKey, AUTO_EXPOSURE_KEY_MIN);
		float maxLuminance = in_luminanceAverage[0] * K;
		exposure = 1.0f / max(maxLuminance, EPSILON);
		// EV-stops bias on top of the auto result, for content tweaking
		// without re-tuning K. exp2(EV) is the standard EV-to-multiplier mapping.
		exposure *= exp2(g_Frame.autoExposureCompensation);
	}
	else
	{
		float EV100 = ComputeEV100(g_Frame.aperture, g_Frame.shutterTime, g_Frame.ISO);
		exposure = ConvertEV100ToExposure(EV100);
	}

	float3 basePassxyY = RGB_XYY(basePass);
	basePassxyY.z *= exposure;

	basePass = XYY_RGB(basePassxyY);

	// Tone Mapping. TonemapAGX returns gamma-encoded display-referred sRGB
	// (pow(2.2) is applied inside the function per Filament/Three.js canonical
	// AgX). Do NOT re-encode here - that was the TASK-141 double-gamma bug.
	float3 finalColor = TonemapAGX(basePass);

	out_finalBlendPassRT0[input.dispatchThreadID.xy] = float4(finalColor, 1.0f);
	DeviceMemoryBarrier();
}