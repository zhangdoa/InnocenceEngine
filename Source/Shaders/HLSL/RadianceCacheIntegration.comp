// shadertype=hlsl
#include "common/common.hlsl"
#include "RayTracingTypes.hlsl"

struct ComputeInputType
{
    uint3 groupID : SV_GroupID;               // Workgroup ID
    uint3 groupThreadID : SV_GroupThreadID;   // Local thread ID in workgroup
    uint3 dispatchThreadID : SV_DispatchThreadID; // Global thread ID
    uint groupIndex : SV_GroupIndex;          // Flattened thread index
};

[[vk::binding(0, 0)]]
Texture2D<float4> in_RadianceCacheResults_Input : register(t0);

[[vk::binding(0, 1)]]
RWTexture2D<float4> in_RadianceCacheResults_Output : register(u0);

static const float SH_NORMALIZE_FACTOR = 4.0 * PI / float(TILE_SIZE * TILE_SIZE);
static const uint THREAD_COUNT = TILE_SIZE * TILE_SIZE; // 64

groupshared float3 gs_SH_L0[THREAD_COUNT];
groupshared float3 gs_SH_L1_x[THREAD_COUNT];
groupshared float3 gs_SH_L1_y[THREAD_COUNT];
groupshared float3 gs_SH_L1_z[THREAD_COUNT];

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void main(ComputeInputType input)
{
    uint2 probeIndex = input.groupID.xy;
    uint threadIndex = input.groupIndex;
    uint x = input.groupThreadID.x;
    uint y = input.groupThreadID.y;

    uint2 readCoord = probeIndex * TILE_SIZE + uint2(x, y);
    float3 radiance = max(in_RadianceCacheResults_Input.Load(int3(readCoord, 0)).xyz, float3(0, 0, 0));

    float radianceMagnitude = length(radiance);
    if (radianceMagnitude > 1000.0)
        radiance = normalize(radiance) * 1000.0;

    float2 uv = float2(x, y) / TILE_SIZE;
    float3 sampleDir = DecodeOctahedral(uv);

    float shWeight = SH_NORMALIZE_FACTOR;
    gs_SH_L0[threadIndex] = radiance * Y_00() * shWeight;
    gs_SH_L1_x[threadIndex] = radiance * Y_11(sampleDir) * shWeight;
    gs_SH_L1_y[threadIndex] = radiance * Y_1_1(sampleDir) * shWeight;
    gs_SH_L1_z[threadIndex] = radiance * Y_10(sampleDir) * shWeight;

    GroupMemoryBarrierWithGroupSync();

    // Parallel reduction
    for (uint stride = THREAD_COUNT / 2; stride > 0; stride >>= 1)
    {
        if (threadIndex < stride)
        {
            gs_SH_L0[threadIndex] += gs_SH_L0[threadIndex + stride];
            gs_SH_L1_x[threadIndex] += gs_SH_L1_x[threadIndex + stride];
            gs_SH_L1_y[threadIndex] += gs_SH_L1_y[threadIndex + stride];
            gs_SH_L1_z[threadIndex] += gs_SH_L1_z[threadIndex + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (threadIndex == 0)
    {
        uint2 writeCoord = probeIndex * SH_TILE_SIZE;

        // Read previous frame's SH (persists in the output UAV)
        float3 prevSH_L0   = in_RadianceCacheResults_Output[writeCoord + uint2(0, 0)].rgb;
        float3 prevSH_L1_x = in_RadianceCacheResults_Output[writeCoord + uint2(1, 0)].rgb;
        float3 prevSH_L1_y = in_RadianceCacheResults_Output[writeCoord + uint2(0, 1)].rgb;
        float3 prevSH_L1_z = in_RadianceCacheResults_Output[writeCoord + uint2(1, 1)].rgb;

        // Temporal blend: 90% history, 10% current. Use 100% current when no history.
        float blend = (dot(prevSH_L0, prevSH_L0) < 0.001) ? 1.0 : 0.1;

        in_RadianceCacheResults_Output[writeCoord + uint2(0, 0)] = float4(lerp(prevSH_L0,   gs_SH_L0[0],   blend), 1.0);
        in_RadianceCacheResults_Output[writeCoord + uint2(1, 0)] = float4(lerp(prevSH_L1_x, gs_SH_L1_x[0], blend), 1.0);
        in_RadianceCacheResults_Output[writeCoord + uint2(0, 1)] = float4(lerp(prevSH_L1_y, gs_SH_L1_y[0], blend), 1.0);
        in_RadianceCacheResults_Output[writeCoord + uint2(1, 1)] = float4(lerp(prevSH_L1_z, gs_SH_L1_z[0], blend), 1.0);
    }
}
