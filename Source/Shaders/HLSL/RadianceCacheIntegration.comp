// shadertype=hlsl
#include "common/common.hlsl"
#include "RayTracingTypes.hlsl"

struct ComputeInputType
{
    uint3 groupID : SV_GroupID;               // Workgroup ID
    uint3 groupThreadID : SV_GroupThreadID;   // Local thread ID in workgroup
    uint3 dispatchThreadID : SV_DispatchThreadID; // Global thread ID
    uint groupIndex : SV_GroupIndex;          // Flattened thread index
};

[[vk::binding(0, 0)]]
Texture2D<float4> in_RadianceCacheResults_Input : register(t0);

[[vk::binding(0, 1)]]
RWTexture2D<float4> in_RadianceCacheResults_Output : register(u0);

static const float SH_NORMALIZE_FACTOR = 4.0 * PI / float(TILE_SIZE * TILE_SIZE);
static const uint THREAD_COUNT = TILE_SIZE * TILE_SIZE; // 64

// SH L=0 (1) + L=1 (3) + L=2 (5) = 9 coefficients, each float3 for RGB.
groupshared float3 gs_SH0[THREAD_COUNT];
groupshared float3 gs_SH1[THREAD_COUNT];
groupshared float3 gs_SH2[THREAD_COUNT];
groupshared float3 gs_SH3[THREAD_COUNT];
groupshared float3 gs_SH4[THREAD_COUNT];
groupshared float3 gs_SH5[THREAD_COUNT];
groupshared float3 gs_SH6[THREAD_COUNT];
groupshared float3 gs_SH7[THREAD_COUNT];
groupshared float3 gs_SH8[THREAD_COUNT];

// [S1.4] radiance-average backup pre-reduction: sum of traced radiance +
// count of traced cells, reduced across the 64 probe cells. Atlas alpha
// stores ray travel distance ([S1.2]), so alpha == 0 flags a cell that
// has never been traced. Untraced cells are replaced with the traced-
// cell average before SH projection so partial-coverage probes don't
// bias SH toward zero in the directions we haven't sampled yet.
groupshared float3 gs_avgSum[THREAD_COUNT];
groupshared float gs_avgCount[THREAD_COUNT];

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void main(ComputeInputType input)
{
    uint2 probeIndex = input.groupID.xy;
    uint threadIndex = input.groupIndex;
    uint x = input.groupThreadID.x;
    uint y = input.groupThreadID.y;

    uint2 readCoord = probeIndex * TILE_SIZE + uint2(x, y);
    float4 atlasSample = in_RadianceCacheResults_Input.Load(int3(readCoord, 0));
    float3 radiance = max(atlasSample.xyz, float3(0, 0, 0));
    float rayDistance = atlasSample.w;

    float radianceMagnitude = length(radiance);
    if (radianceMagnitude > 1000.0)
        radiance = normalize(radiance) * 1000.0;

    // [S1.4] radiance-average backup: seed the per-probe average reduction
    // from cells with a non-zero ray-travel-distance record. rayDistance
    // is written by RayGen ([S1.2]); a cell with rayDistance > 0 has been
    // traced at some point in the temporal history, alpha == 0 flags a
    // cell that's never been sampled.
    bool tracedCell = rayDistance > 0.0;
    gs_avgSum[threadIndex] = tracedCell ? radiance : float3(0, 0, 0);
    gs_avgCount[threadIndex] = tracedCell ? 1.0 : 0.0;

    GroupMemoryBarrierWithGroupSync();

    for (uint avgStride = THREAD_COUNT / 2; avgStride > 0; avgStride >>= 1)
    {
        if (threadIndex < avgStride)
        {
            gs_avgSum[threadIndex] += gs_avgSum[threadIndex + avgStride];
            gs_avgCount[threadIndex] += gs_avgCount[threadIndex + avgStride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // Coverage gate: paper's backup assumes enough ray budget that a probe
    // is near-saturated (most of 64 cells traced), and fills the few
    // remaining untraced cells with the average so SH DC isn't biased by
    // zero-radiance directions. Below the threshold we leave untraced
    // cells at zero — our sparse-spawning configuration (1 ray per spawn
    // tile per frame) hits only ~20% coverage for most of the scene, and
    // filling 80% of a probe with an avg-of-a-dozen-cells doubles SH DC
    // and produces strong per-probe brightness banding. If ray budget
    // grows (e.g. [S1.5c-override-full] adds extra rays) this gate
    // activates automatically for the probes that become dense enough.
    const float COVERAGE_ACTIVATION_THRESHOLD = 0.9;
    float coverage = gs_avgCount[0] / float(THREAD_COUNT);
    float3 tracedAvg = gs_avgCount[0] > 0.5 ? (gs_avgSum[0] / gs_avgCount[0]) : float3(0, 0, 0);
    if (!tracedCell && coverage > COVERAGE_ACTIVATION_THRESHOLD)
        radiance = tracedAvg;

    float2 uv = float2(x, y) / TILE_SIZE;
    float3 w = DecodeOctahedral(uv);

    float W = SH_NORMALIZE_FACTOR;
    gs_SH0[threadIndex] = radiance * Y_00()   * W;
    gs_SH1[threadIndex] = radiance * Y_11 (w) * W;
    gs_SH2[threadIndex] = radiance * Y_1_1(w) * W;
    gs_SH3[threadIndex] = radiance * Y_10 (w) * W;
    gs_SH4[threadIndex] = radiance * Y_2_2(w) * W;
    gs_SH5[threadIndex] = radiance * Y_2_1(w) * W;
    gs_SH6[threadIndex] = radiance * Y_20 (w) * W;
    gs_SH7[threadIndex] = radiance * Y_21 (w) * W;
    gs_SH8[threadIndex] = radiance * Y_22 (w) * W;

    GroupMemoryBarrierWithGroupSync();

    // Parallel reduction across the 64 threads.
    for (uint stride = THREAD_COUNT / 2; stride > 0; stride >>= 1)
    {
        if (threadIndex < stride)
        {
            gs_SH0[threadIndex] += gs_SH0[threadIndex + stride];
            gs_SH1[threadIndex] += gs_SH1[threadIndex + stride];
            gs_SH2[threadIndex] += gs_SH2[threadIndex + stride];
            gs_SH3[threadIndex] += gs_SH3[threadIndex + stride];
            gs_SH4[threadIndex] += gs_SH4[threadIndex + stride];
            gs_SH5[threadIndex] += gs_SH5[threadIndex + stride];
            gs_SH6[threadIndex] += gs_SH6[threadIndex + stride];
            gs_SH7[threadIndex] += gs_SH7[threadIndex + stride];
            gs_SH8[threadIndex] += gs_SH8[threadIndex + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (threadIndex == 0)
    {
        // 3×3 storage layout (row-major within each probe):
        //   (0,0)=Y00     (1,0)=Y11   (2,0)=Y1_1
        //   (0,1)=Y10     (1,1)=Y2_2  (2,1)=Y2_1
        //   (0,2)=Y20     (1,2)=Y21   (2,2)=Y22
        // LoadIrradiance in lightPass.comp uses the same ordering to pair
        // coefficients with basis functions.
        uint2 base = probeIndex * SH_TILE_SIZE;

        float3 p0 = in_RadianceCacheResults_Output[base + uint2(0, 0)].rgb;
        float3 p1 = in_RadianceCacheResults_Output[base + uint2(1, 0)].rgb;
        float3 p2 = in_RadianceCacheResults_Output[base + uint2(2, 0)].rgb;
        float3 p3 = in_RadianceCacheResults_Output[base + uint2(0, 1)].rgb;
        float3 p4 = in_RadianceCacheResults_Output[base + uint2(1, 1)].rgb;
        float3 p5 = in_RadianceCacheResults_Output[base + uint2(2, 1)].rgb;
        float3 p6 = in_RadianceCacheResults_Output[base + uint2(0, 2)].rgb;
        float3 p7 = in_RadianceCacheResults_Output[base + uint2(1, 2)].rgb;
        float3 p8 = in_RadianceCacheResults_Output[base + uint2(2, 2)].rgb;

        // Temporal blend: 90% history, 10% current; use 100% current when
        // no prior L0 is detectable (first frame / tile-level disocclusion).
        float blend = (dot(p0, p0) < 0.001) ? 1.0 : 0.1;

        in_RadianceCacheResults_Output[base + uint2(0, 0)] = float4(lerp(p0, gs_SH0[0], blend), 1.0);
        in_RadianceCacheResults_Output[base + uint2(1, 0)] = float4(lerp(p1, gs_SH1[0], blend), 1.0);
        in_RadianceCacheResults_Output[base + uint2(2, 0)] = float4(lerp(p2, gs_SH2[0], blend), 1.0);
        in_RadianceCacheResults_Output[base + uint2(0, 1)] = float4(lerp(p3, gs_SH3[0], blend), 1.0);
        in_RadianceCacheResults_Output[base + uint2(1, 1)] = float4(lerp(p4, gs_SH4[0], blend), 1.0);
        in_RadianceCacheResults_Output[base + uint2(2, 1)] = float4(lerp(p5, gs_SH5[0], blend), 1.0);
        in_RadianceCacheResults_Output[base + uint2(0, 2)] = float4(lerp(p6, gs_SH6[0], blend), 1.0);
        in_RadianceCacheResults_Output[base + uint2(1, 2)] = float4(lerp(p7, gs_SH7[0], blend), 1.0);
        in_RadianceCacheResults_Output[base + uint2(2, 2)] = float4(lerp(p8, gs_SH8[0], blend), 1.0);
    }
    DeviceMemoryBarrier();
}
