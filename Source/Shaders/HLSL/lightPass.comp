// shadertype=hlsl
//
// LightPass kernel. One thread per screen pixel: decode the GBuffer,
// evaluate sun + tiled point lights into a (direct, indirect-seed)
// pair, compose the radiance-cache indirect into the direct
// accumulator for output, write the indirect-seed to RT1 for next-
// frame ray accumulation.
//
// Stages live in headers so this file stays focused on bindings + the
// thread-group entry. See:
//   common/lightPassCommon.hlsl          — GBuffer decode + per-light BSDF accumulator
//   common/lightPassDirectLighting.hlsl  — sun + tiled point-light evaluators
//   common/lightPassIndirectCompose.hlsl — radiance-cache irradiance compose

#include "common/common.hlsl"

struct ComputeInputType
{
	uint3 groupID : SV_GroupID;
	uint3 groupThreadID : SV_GroupThreadID;
	uint3 dispatchThreadID : SV_DispatchThreadID;
	uint  groupIndex : SV_GroupIndex;
};

[[vk::binding(0, 0)]]
cbuffer PerFrameConstantBuffer : register(b0)
{
	PerFrame_CB g_Frame;
}

[[vk::binding(1, 0)]]
cbuffer PointLightCBuffer : register(b1)
{
	PointLight_CB g_PointLights[NR_POINT_LIGHTS];
};

[[vk::binding(2, 0)]]
cbuffer SphereLightCBuffer : register(b2)
{
	SphereLight_CB g_SphereLights[NR_SPHERE_LIGHTS];
};

// HLSL register b3 (was CSMCBuffer) is intentionally unused after the TASK-138
// CSM swap — keeping the slot empty avoids cascading renumbers across the
// other lightPass cbuffers.

[[vk::binding(4, 0)]]
cbuffer VoxelizationPassCBuffer : register(b4)
{
	VoxelizationPass_CB g_VoxelizationPassCBuffer;
};

[[vk::binding(5, 0)]]
cbuffer GICBuffer : register(b5)
{
	GI_CB GICBuffer;
};

[[vk::binding(0, 1)]]
Texture2D in_opaquePassRT0 : register(t0);
[[vk::binding(1, 1)]]
Texture2D in_opaquePassRT1 : register(t1);
[[vk::binding(2, 1)]]
Texture2D in_opaquePassRT2 : register(t2);
[[vk::binding(3, 1)]]
Texture2D in_opaquePassRT3 : register(t3);
[[vk::binding(4, 1)]]
Texture2D in_BRDFLUT : register(t4);
[[vk::binding(5, 1)]]
Texture2D in_BRDFMSLUT : register(t5);
[[vk::binding(6, 1)]]
Texture2D in_SSAO : register(t6);
// HLSL register t7 (was the sun CSM atlas) is intentionally unused after the
// TASK-138 swap; LightPass binds RT visibility at t13 instead.
[[vk::binding(8, 1)]]
Texture2D<uint2> in_LightGrid : register(t8);
[[vk::binding(9, 1)]]
StructuredBuffer<uint> in_LightIndexList : register(t9);
// Denoised per-pixel indirect irradiance produced by GIDenoisePass.
// rgb = irradiance, a = linear depth (LightPass only consumes rgb).
[[vk::binding(10, 1)]]
Texture2D<float4> in_GIIrradiance : register(t10);
[[vk::binding(11, 1)]]
Texture3D<float4> in_VolumetricFog : register(t11);
// Per-pixel hardware-RT sun-shadow visibility. R8 unorm, 0 = fully shadowed,
// 1 = lit. Produced by SunShadowRTPass; consumed by EvaluateSunLighting.
[[vk::binding(13, 1)]]
Texture2D<float> in_SunShadowRTVisibility : register(t13);
// TASK-176: Scene TLAS for inline RayQuery<> shadow rays in
// EvaluateTiledPointLighting. cs_6_5 / DXR Tier 1.1 — see Compile-HLSL.psm1
// per-file profile override. Same TLAS bound by SunShadowRTPass / PT —
// GPUBufferResourceService owns one TLAS per frame.
[[vk::binding(14, 1)]]
RaytracingAccelerationStructure SceneAS : register(t14);
[[vk::binding(1, 2)]]
SamplerState in_samplerTypePoint : register(s1);
[[vk::binding(0, 3)]]
RWTexture2D<float4> out_lightPassRT0 : register(u0);
[[vk::binding(1, 3)]]
RWTexture2D<float4> out_lightPassRT1 : register(u1);

#include "common/BSDF.hlsl"
#include "common/lightPassCommon.hlsl"
#include "common/lightPassDirectLighting.hlsl"
#include "common/lightPassIndirectCompose.hlsl"

// TASK-183: write raw GBuffer / shadow / heatmap data into RT0 for the
// debug-view modes whose output is a single channel of upstream pass
// state, not a recomputation of lighting. Returns immediately after
// writing — no direct / indirect lighting is needed.
//
// out_lightPassRT1 carries the next-frame indirect seed (read by the
// radiance cache). When debug-view replaces RT0 we still want valid
// indirect accumulation downstream, so RT1 keeps whatever the lit path
// would have written. To keep this helper self-contained and avoid
// accumulating any direct light during pure-debug frames, we leave RT1
// at zero: the radiance cache is fed an empty seed for these frames,
// which is acceptable for a transient developer-time debug view (the
// next frame the user clears the debug view, the cache reseeds). Same
// rationale as why TAA is not bypassed for these modes — debug-view is
// for visual inspection at rest, not motion-stable rendering.
void WriteDebugViewRT0(
	in uint in_DebugViewMode,
	in uint2 in_ScreenCoord,
	in MaterialAttributes in_Material,
	in float3 in_NormalWS)
{
	float3 l_DebugRGB = float3(0.0, 0.0, 0.0);

	if (in_DebugViewMode == DEBUG_VIEW_GBUFFER_ALBEDO)
	{
		l_DebugRGB = in_Material.m_Albedo;
	}
	else if (in_DebugViewMode == DEBUG_VIEW_GBUFFER_NORMAL)
	{
		// Map [-1, 1] world-space normal to [0, 1] for display.
		l_DebugRGB = in_NormalWS * 0.5 + 0.5;
	}
	else if (in_DebugViewMode == DEBUG_VIEW_GBUFFER_METALLIC)
	{
		l_DebugRGB = float3(in_Material.m_Metallic, in_Material.m_Metallic, in_Material.m_Metallic);
	}
	else if (in_DebugViewMode == DEBUG_VIEW_GBUFFER_ROUGHNESS)
	{
		l_DebugRGB = float3(in_Material.m_Roughness, in_Material.m_Roughness, in_Material.m_Roughness);
	}
	else if (in_DebugViewMode == DEBUG_VIEW_GBUFFER_MOTION_VECTOR)
	{
		// RG = motion vector in screen-pixel units (OpaquePass.frag:124).
		// Map to [0, 1] colour by abs + clamp; magnitude saturates above
		// 64 px/frame which is well past TAA's clamp ceiling.
		float2 l_Motion = in_opaquePassRT3[in_ScreenCoord].xy;
		const float MOTION_DISPLAY_SCALE_PX = 64.0;
		float2 l_Display = saturate(abs(l_Motion) / MOTION_DISPLAY_SCALE_PX);
		l_DebugRGB = float3(l_Display.x, l_Display.y, 0.0);
	}
	else if (in_DebugViewMode == DEBUG_VIEW_SUN_SHADOW_VISIBILITY)
	{
		float l_Vis = in_SunShadowRTVisibility.Load(int3(in_ScreenCoord, 0));
		l_DebugRGB = float3(l_Vis, l_Vis, l_Vis);
	}
	else if (in_DebugViewMode == DEBUG_VIEW_TILE_LIGHT_COUNT_HEATMAP)
	{
		// Same palette as LightCullingPass.comp's debug heatmap (Filament's
		// listing 45) so the two visualizations are colour-comparable.
		uint2 l_TileIndex = uint2(floor((float2)in_ScreenCoord / LIGHT_CULLING_BLOCK_SIZE));
		uint l_LightCount = in_LightGrid[l_TileIndex].y;
		uint l_PaletteIndex = min(l_LightCount, DEBUG_VIEW_TILE_LIGHT_HEATMAP_MAX - 1u);
		l_DebugRGB = debugColors[l_PaletteIndex].rgb;
	}

	// Tag alpha = 1 so downstream HUD overlays in finalBlendPass (which look
	// for alpha == 1 to identify debug pixels) treat the whole frame as the
	// debug channel. This also guarantees finalBlendPass's debug-overlay
	// branch does not paint over the debug view.
	out_lightPassRT0[in_ScreenCoord] = float4(l_DebugRGB, 1.0);
	out_lightPassRT1[in_ScreenCoord] = float4(0.0, 0.0, 0.0, 0.0);
}

[numthreads(8, 8, 1)]
void main(ComputeInputType input)
{
	uint2 l_ScreenCoord = input.dispatchThreadID.xy;
	out_lightPassRT0[l_ScreenCoord] = float4(0.0, 0.0, 0.0, 0.0);
	out_lightPassRT1[l_ScreenCoord] = float4(0.0, 0.0, 0.0, 0.0);

	float3 l_PositionWS;
	float3 l_NormalWS;
	MaterialAttributes l_Material;
	if (!DecodeGBuffer(in_opaquePassRT0, in_opaquePassRT1, in_opaquePassRT2, l_ScreenCoord, l_PositionWS, l_NormalWS, l_Material))
	{
		DeviceMemoryBarrier();
		return;
	}

	// TASK-183 raw-channel debug views: write the requested upstream-pass
	// channel directly to RT0 and skip the BSDF / GI evaluators. Tile-light
	// heatmap, sun shadow, GBuffer channels — none of these depend on the
	// current pixel's lighting, so paying for the BSDF math is wasteful.
	if (DebugViewModeReplacesRT0(g_Frame.debugViewMode))
	{
		WriteDebugViewRT0(g_Frame.debugViewMode, l_ScreenCoord, l_Material, l_NormalWS);
		DeviceMemoryBarrier();
		return;
	}

	float3 l_V = normalize(g_Frame.camera_posWS.xyz - l_PositionWS);

	float3 l_DirectLuminance = float3(0.0, 0.0, 0.0);
	float3 l_IndirectSeedLuminance = float3(0.0, 0.0, 0.0);

	EvaluateSunLighting(
		in_BRDFLUT, in_BRDFMSLUT, in_samplerTypePoint,
		in_SunShadowRTVisibility,
		l_Material, l_PositionWS, l_NormalWS, l_V, l_ScreenCoord,
		l_DirectLuminance, l_IndirectSeedLuminance);

	EvaluateTiledPointLighting(
		in_BRDFLUT, in_BRDFMSLUT, in_samplerTypePoint,
		in_LightGrid, in_LightIndexList,
		SceneAS,
		l_Material, l_PositionWS, l_NormalWS, l_V, l_ScreenCoord,
		l_DirectLuminance, l_IndirectSeedLuminance);

	float3 l_IndirectLuminance = ComposeIndirectLighting(in_GIIrradiance, l_ScreenCoord, l_Material);

	// TASK-183 lit-composite debug views: zero one term while keeping the
	// other live. DirectOnly bypasses GI compose; IndirectOnly bypasses the
	// direct accumulation. Replaces the former #define DEBUG_INDIRECT_FROM_CACHE_ONLY.
	float3 l_FinalLuminance;
	if (g_Frame.debugViewMode == DEBUG_VIEW_INDIRECT_LIGHTING_ONLY)
	{
		l_FinalLuminance = l_IndirectLuminance;
	}
	else if (g_Frame.debugViewMode == DEBUG_VIEW_DIRECT_LIGHTING_ONLY)
	{
		l_FinalLuminance = l_DirectLuminance;
	}
	else
	{
		// Normal path: GI composes into the visual RT only; the illuminance
		// RT (RT1) carries direct lighting only so next-frame ray hits do
		// not re-accumulate already-accumulated indirect energy.
		l_FinalLuminance = l_DirectLuminance + l_IndirectLuminance;
	}

	out_lightPassRT0[l_ScreenCoord] = float4(l_FinalLuminance, 1.0);
	out_lightPassRT1[l_ScreenCoord] = float4(l_IndirectSeedLuminance, 1.0);
	DeviceMemoryBarrier();
}
