// shadertype=hlsl
//
// LightPass kernel. One thread per screen pixel: decode the GBuffer,
// evaluate sun + tiled point lights into a (direct, indirect-seed)
// pair, compose the radiance-cache indirect into the direct
// accumulator for output, write the indirect-seed to RT1 for next-
// frame ray accumulation.
//
// Stages live in headers so this file stays focused on bindings + the
// thread-group entry. See:
//   common/lightPassCommon.hlsl          — GBuffer decode + per-light BSDF accumulator
//   common/lightPassDirectLighting.hlsl  — sun + tiled point-light evaluators
//   common/lightPassIndirectCompose.hlsl — radiance-cache irradiance compose

#include "common/common.hlsl"

struct ComputeInputType
{
	uint3 groupID : SV_GroupID;
	uint3 groupThreadID : SV_GroupThreadID;
	uint3 dispatchThreadID : SV_DispatchThreadID;
	uint  groupIndex : SV_GroupIndex;
};

[[vk::binding(0, 0)]]
cbuffer PerFrameConstantBuffer : register(b0)
{
	PerFrame_CB g_Frame;
}

[[vk::binding(1, 0)]]
cbuffer PointLightCBuffer : register(b1)
{
	PointLight_CB g_PointLights[NR_POINT_LIGHTS];
};

[[vk::binding(2, 0)]]
cbuffer SphereLightCBuffer : register(b2)
{
	SphereLight_CB g_SphereLights[NR_SPHERE_LIGHTS];
};

[[vk::binding(3, 0)]]
cbuffer CSMCBuffer : register(b3)
{
	CSM_CB CSMs[NR_CSM_SPLITS];
};

[[vk::binding(4, 0)]]
cbuffer VoxelizationPassCBuffer : register(b4)
{
	VoxelizationPass_CB g_VoxelizationPassCBuffer;
};

[[vk::binding(5, 0)]]
cbuffer GICBuffer : register(b5)
{
	GI_CB GICBuffer;
};

// TASK-148: per-shadow-casting-light metadata for the cube-shadow resolver.
// Slot count is bounded by RenderingCapability::maxPointShadows (= NR_POINT_SHADOWS).
// Inactive entries carry isActive=0 and atlasBaseSlot=INVALID_ATLAS_SLOT;
// PointShadowResolver short-circuits on either before sampling.
[[vk::binding(6, 0)]]
cbuffer PointShadowCBuffer : register(b6)
{
	PointShadow_CB g_PointShadows[NR_POINT_SHADOWS];
};

[[vk::binding(0, 1)]]
Texture2D in_opaquePassRT0 : register(t0);
[[vk::binding(1, 1)]]
Texture2D in_opaquePassRT1 : register(t1);
[[vk::binding(2, 1)]]
Texture2D in_opaquePassRT2 : register(t2);
[[vk::binding(3, 1)]]
Texture2D in_opaquePassRT3 : register(t3);
[[vk::binding(4, 1)]]
Texture2D in_BRDFLUT : register(t4);
[[vk::binding(5, 1)]]
Texture2D in_BRDFMSLUT : register(t5);
[[vk::binding(6, 1)]]
Texture2D in_SSAO : register(t6);
[[vk::binding(7, 1)]]
Texture2DArray in_SunShadow : register(t7);
[[vk::binding(8, 1)]]
Texture2D<uint2> in_LightGrid : register(t8);
[[vk::binding(9, 1)]]
StructuredBuffer<uint> in_LightIndexList : register(t9);
// Denoised per-pixel indirect irradiance produced by GIDenoisePass.
// rgb = irradiance, a = linear depth (LightPass only consumes rgb).
[[vk::binding(10, 1)]]
Texture2D<float4> in_GIIrradiance : register(t10);
[[vk::binding(11, 1)]]
Texture3D<float4> in_VolumetricFog : register(t11);
// TASK-148: point/sphere cube-shadow atlas. Texture2DArray with
// DepthOrArraySize = NR_POINT_SHADOWS * 6, R32G32_FLOAT (.r=linearDist,
// .g=linearDist²). Sampled via PointShadowResolver in shadowResolver.hlsl.
[[vk::binding(12, 1)]]
Texture2DArray in_PointShadow : register(t12);
// TASK-138 phase 1: per-pixel hardware-RT sun-shadow visibility. R8 unorm,
// 0 = fully shadowed, 1 = lit. Produced by SunShadowRTPass; consumed by
// EvaluateSunLighting when USE_RT_SHADOWS is set in lightPassDirectLighting.
// Co-exists with the CSM atlas at t7 until cost-budgeted swap decision.
[[vk::binding(13, 1)]]
Texture2D<float> in_SunShadowRTVisibility : register(t13);
[[vk::binding(0, 2)]]
SamplerState in_samplerTypeLinear : register(s0);
[[vk::binding(1, 2)]]
SamplerState in_samplerTypePoint : register(s1);
[[vk::binding(0, 3)]]
RWTexture2D<float4> out_lightPassRT0 : register(u0);
[[vk::binding(1, 3)]]
RWTexture2D<float4> out_lightPassRT1 : register(u1);

#include "common/BSDF.hlsl"
#include "common/shadowResolver.hlsl"
#include "common/lightPassCommon.hlsl"
#include "common/lightPassDirectLighting.hlsl"
#include "common/lightPassIndirectCompose.hlsl"

// Debug toggles. Both compile-time false in shipping; flip locally to
// inspect cascade coverage / isolated GI compose without redispatching.
#define DEBUG_INDIRECT_FROM_CACHE_ONLY 0

[numthreads(8, 8, 1)]
void main(ComputeInputType input)
{
	uint2 l_ScreenCoord = input.dispatchThreadID.xy;
	out_lightPassRT0[l_ScreenCoord] = float4(0.0, 0.0, 0.0, 0.0);
	out_lightPassRT1[l_ScreenCoord] = float4(0.0, 0.0, 0.0, 0.0);

	float3 l_PositionWS;
	float3 l_NormalWS;
	MaterialAttributes l_Material;
	if (!DecodeGBuffer(in_opaquePassRT0, in_opaquePassRT1, in_opaquePassRT2, l_ScreenCoord, l_PositionWS, l_NormalWS, l_Material))
	{
		DeviceMemoryBarrier();
		return;
	}

	float3 l_V = normalize(g_Frame.camera_posWS.xyz - l_PositionWS);

	float3 l_DirectLuminance = float3(0.0, 0.0, 0.0);
	float3 l_IndirectSeedLuminance = float3(0.0, 0.0, 0.0);

	EvaluateSunLighting(
		in_BRDFLUT, in_BRDFMSLUT, in_samplerTypePoint,
		in_SunShadow, in_samplerTypeLinear,
		in_SunShadowRTVisibility,
		l_Material, l_PositionWS, l_NormalWS, l_V, l_ScreenCoord,
		l_DirectLuminance, l_IndirectSeedLuminance);

	EvaluateTiledPointLighting(
		in_BRDFLUT, in_BRDFMSLUT, in_samplerTypePoint,
		in_LightGrid, in_LightIndexList,
		in_PointShadow, in_samplerTypeLinear,
		l_Material, l_PositionWS, l_NormalWS, l_V, l_ScreenCoord,
		l_DirectLuminance, l_IndirectSeedLuminance);

	float3 l_IndirectLuminance = ComposeIndirectLighting(in_GIIrradiance, l_ScreenCoord, l_Material);
	// GI composes into the visual RT only; the illuminance RT carries
	// direct lighting only so next-frame ray hits do not re-accumulate
	// already-accumulated indirect energy.
	l_DirectLuminance += l_IndirectLuminance;

#if DEBUG_INDIRECT_FROM_CACHE_ONLY
	out_lightPassRT0[l_ScreenCoord] = float4(l_IndirectLuminance, 1.0);
#else
	out_lightPassRT0[l_ScreenCoord] = float4(l_DirectLuminance, 1.0);
#endif
	out_lightPassRT1[l_ScreenCoord] = float4(l_IndirectSeedLuminance, 1.0);
	DeviceMemoryBarrier();
}
