// shadertype=hlsl
#include "common/RadianceCacheCommon.hlsl"
#include "RayTracingTypes.hlsl"

struct ComputeInputType
{
	uint3 groupID : SV_GroupID;
	uint3 groupThreadID : SV_GroupThreadID;
	uint3 dispatchThreadID : SV_DispatchThreadID;
	uint  groupIndex : SV_GroupIndex;
};

[[vk::binding(0, 0)]]
cbuffer PerFrameConstantBuffer : register(b0)
{
	PerFrame_CB g_Frame;
}

[[vk::binding(0, 1)]]
Texture2D in_opaquePassRT0 : register(t0);
[[vk::binding(1, 1)]]
Texture2D in_opaquePassRT1 : register(t1);
[[vk::binding(2, 1)]]
Texture2D in_opaquePassRT3 : register(t2);
[[vk::binding(3, 1)]]
Texture2D<float4> in_RadianceCache : register(t3);
[[vk::binding(4, 1)]]
Texture2D<float4> in_ProbePosition : register(t4);
[[vk::binding(5, 1)]]
Texture2D<float4> in_ProbeNormal : register(t5);
[[vk::binding(6, 1)]]
Texture2D<uint> in_ProbeMask : register(t6);
[[vk::binding(7, 1)]]
Texture2D<float4> in_GIHistoryPrev : register(t7);
// Previous-frame SVGF moments: r = E[luma], g = E[luma²],
// b = history-count N, a = unused. N = 0 = invalid / uninitialised, so
// fresh memory reads as "disocclusion" without a per-frame clear.
[[vk::binding(8, 1)]]
Texture2D<float4> in_MomentsPrev : register(t8);

[[vk::binding(0, 2)]]
RWTexture2D<float4> out_GIHistory : register(u0);
[[vk::binding(1, 2)]]
RWTexture2D<float4> out_MomentsCurrent : register(u1);

// SVGF temporal accumulation caps (Schied et al. 2017). N grows by 1 per
// successful reprojection until MAX_HISTORY_N — used here to pace the
// per-pixel exponential average, and will drive the A-trous spatial
// filter radius in [I.3e.3].
static const float MAX_HISTORY_N = 32.0;
// Floor on temporal blend rate — without it the accumulation weights the
// first sample infinitely (N → ∞ ⇒ α → 0), so a single bad probe
// propagates forever. 1/20 matches SVGF's usual choice.
static const float MIN_TEMPORAL_ALPHA = 0.05;

// GI-1.0 §2.4.2 irradiance evaluation via Ramamoorthi–Hanrahan 2001
// cosine-lobe convolution. 9 coefficients (bands 0–2) packed row-major
// in a 3×3 SH tile per probe:
//   (0,0)=Y00   (1,0)=Y11   (2,0)=Y1_1
//   (0,1)=Y10   (1,1)=Y2_2  (2,1)=Y2_1
//   (0,2)=Y20   (1,2)=Y21   (2,2)=Y22
float3 LoadIrradiance(uint2 shReadCoord, float3 n)
{
	float3 c00 = in_RadianceCache[shReadCoord + uint2(0, 0)].rgb;
	float3 c11 = in_RadianceCache[shReadCoord + uint2(1, 0)].rgb;
	float3 c1_1 = in_RadianceCache[shReadCoord + uint2(2, 0)].rgb;
	float3 c10 = in_RadianceCache[shReadCoord + uint2(0, 1)].rgb;
	float3 c2_2 = in_RadianceCache[shReadCoord + uint2(1, 1)].rgb;
	float3 c2_1 = in_RadianceCache[shReadCoord + uint2(2, 1)].rgb;
	float3 c20 = in_RadianceCache[shReadCoord + uint2(0, 2)].rgb;
	float3 c21 = in_RadianceCache[shReadCoord + uint2(1, 2)].rgb;
	float3 c22 = in_RadianceCache[shReadCoord + uint2(2, 2)].rgb;

	const float A0 = 1.0;
	const float A1 = 2.0 / 3.0;
	const float A2 = 1.0 / 4.0;

	float3 band0 = A0 * c00  * Y_00();
	float3 band1 = A1 * (c11  * Y_11 (n) + c1_1 * Y_1_1(n) + c10  * Y_10 (n));
	float3 band2 = A2 * (c2_2 * Y_2_2(n) + c2_1 * Y_2_1(n) + c20  * Y_20 (n) +
	                     c21  * Y_21 (n) + c22  * Y_22 (n));

	return max(band0 + band1 + band2, 0.0);
}

// GI-1.0 §2.4 edge-aware probe weight. Returns 0 when the probe is sky /
// off-surface or crosses a plane / normal discontinuity.
float ComputeProbeWeight(uint2 probeCoord, uint2 maxProbeIdx,
                         float3 pixelPos, float3 pixelNormal, float cellSize)
{
	probeCoord = min(probeCoord, maxProbeIdx);
	uint mask = in_ProbeMask[probeCoord];
	if (!IsValidProbe(mask))
		return 0.0;

	float3 probePos = in_ProbePosition[probeCoord].xyz;
	float3 probeNormal = normalize(in_ProbeNormal[probeCoord].xyz);

	float planeDist = abs(dot(probePos - pixelPos, pixelNormal));
	if (planeDist > cellSize)
		return 0.0;

	float normalDot = dot(pixelNormal, probeNormal);
	if (normalDot <= 0.0)
		return 0.0;

	return normalDot * saturate(1.0 - planeDist / cellSize);
}

// GI-1.0 §2.4.1 per-pixel interpolation: weighted average of the 4 probes
// surrounding the pixel. Each corner combines the bilinear weight from
// screen-space position with an edge-aware weight (probe validity + plane
// + normal). Relaxed-interpolation fallback (paper §2.4.1): equal-weight
// screen-bilinear blend so edge pixels don't go black when the local
// neighbourhood has no good probe.
float3 SampleRadianceCache(float2 screenCoord, float3 pixelPos, float3 pixelNormal)
{
	// Probe (i, j) is anchored at tile centre TILE_SIZE * (i + 0.5). Shift the
	// screen coord into probe-grid space (subtract half a tile) so `probeFloor`
	// is the top-left probe of the 4-probe quad that surrounds the pixel, not
	// the tile the pixel happens to land in. Without the shift, crossing a tile
	// boundary discontinuously swaps the set of probes used for interpolation,
	// producing hard tile-grid banding on flat surfaces.
	float2 probeUV = float2(screenCoord) / float2(TILE_SIZE, TILE_SIZE) - 0.5;
	int2 probeFloor = int2(floor(probeUV));
	uint2 maxProbeIndex = uint2(g_Frame.viewportSize.xy) / TILE_SIZE - 1;
	int2 maxProbeIndexI = int2(maxProbeIndex);

	float depth = length(pixelPos - g_Frame.camera_posWS.xyz);
	float cellSize = max(AdaptiveCellSize(depth, g_Frame.viewportSize.xy, g_Frame.p_original), 0.1);

	int2 targetTL = clamp(probeFloor,              int2(0, 0), maxProbeIndexI);
	int2 targetTR = clamp(probeFloor + int2(1, 0), int2(0, 0), maxProbeIndexI);
	int2 targetBL = clamp(probeFloor + int2(0, 1), int2(0, 0), maxProbeIndexI);
	int2 targetBR = clamp(probeFloor + int2(1, 1), int2(0, 0), maxProbeIndexI);

	// Under sparse spawning (upscaleFactor > 1) most 8×8 tiles are
	// PROBE_MASK_INVALID in any given frame. Without ring-search the
	// blend collapses to whichever single corner happens to be valid,
	// producing visible per-tile banding on flat surfaces. Use the same
	// FindClosestProbe ring walk the H/V filter passes use ([S1.5b]) so
	// each corner contributes the closest valid substitute; the edge-
	// aware weight test runs against the SUBSTITUTE's own position /
	// normal (r.tileCoord), preserving plane / hemisphere rejection.
	int2 gridSize = int2(g_Frame.viewportSize.xy) / int(RADIANCE_CACHE_TILE_SIZE);
	ProbeLookup lookupTL = FindClosestProbe(in_ProbeMask, int2(0, 0), targetTL, gridSize);
	ProbeLookup lookupTR = FindClosestProbe(in_ProbeMask, int2(0, 0), targetTR, gridSize);
	ProbeLookup lookupBL = FindClosestProbe(in_ProbeMask, int2(0, 0), targetBL, gridSize);
	ProbeLookup lookupBR = FindClosestProbe(in_ProbeMask, int2(0, 0), targetBR, gridSize);

	uint2 tl = uint2(lookupTL.tileCoord);
	uint2 tr = uint2(lookupTR.tileCoord);
	uint2 bl = uint2(lookupBL.tileCoord);
	uint2 br = uint2(lookupBR.tileCoord);

	float2 bilinear = probeUV - float2(probeFloor);
	float wTL = (1.0 - bilinear.x) * (1.0 - bilinear.y);
	float wTR = bilinear.x * (1.0 - bilinear.y);
	float wBL = (1.0 - bilinear.x) * bilinear.y;
	float wBR = bilinear.x * bilinear.y;

	float eTL = ComputeProbeWeight(tl, maxProbeIndex, pixelPos, pixelNormal, cellSize);
	float eTR = ComputeProbeWeight(tr, maxProbeIndex, pixelPos, pixelNormal, cellSize);
	float eBL = ComputeProbeWeight(bl, maxProbeIndex, pixelPos, pixelNormal, cellSize);
	float eBR = ComputeProbeWeight(br, maxProbeIndex, pixelPos, pixelNormal, cellSize);

	float fTL = wTL * eTL;
	float fTR = wTR * eTR;
	float fBL = wBL * eBL;
	float fBR = wBR * eBR;

	float totalWeight = fTL + fTR + fBL + fBR;

	float3 result;
	if (totalWeight > 0.0)
	{
		float3 ITL = LoadIrradiance(tl * SH_TILE_SIZE, pixelNormal);
		float3 ITR = LoadIrradiance(tr * SH_TILE_SIZE, pixelNormal);
		float3 IBL = LoadIrradiance(bl * SH_TILE_SIZE, pixelNormal);
		float3 IBR = LoadIrradiance(br * SH_TILE_SIZE, pixelNormal);
		result = (fTL * ITL + fTR * ITR + fBL * IBL + fBR * IBR) / totalWeight;
	}
	else
	{
		float3 ITL = LoadIrradiance(tl * SH_TILE_SIZE, pixelNormal);
		float3 ITR = LoadIrradiance(tr * SH_TILE_SIZE, pixelNormal);
		float3 IBL = LoadIrradiance(bl * SH_TILE_SIZE, pixelNormal);
		float3 IBR = LoadIrradiance(br * SH_TILE_SIZE, pixelNormal);
		result = wTL * ITL + wTR * ITR + wBL * IBL + wBR * IBR;
	}

	return max(result, float3(0.0, 0.0, 0.0));
}

[numthreads(8, 8, 1)]
void main(ComputeInputType input)
{
	uint2 l_ScreenCoord = input.dispatchThreadID.xy;

	float4 GPassRT0 = in_opaquePassRT0[l_ScreenCoord];

	// Sky / no geometry: leave a sentinel (0 irradiance, 0 depth) so next
	// frame's reprojection rejects this tap. Also reset moments so a tile
	// that becomes sky then re-occupied doesn't carry stale N.
	if (GPassRT0.a == 0.0)
	{
		out_GIHistory[l_ScreenCoord] = float4(0.0, 0.0, 0.0, 0.0);
		out_MomentsCurrent[l_ScreenCoord] = float4(0.0, 0.0, 0.0, 0.0);
		return;
	}

	float4 GPassRT1 = in_opaquePassRT1[l_ScreenCoord];
	float3 l_Position_WorldSpace = GPassRT0.xyz;
	float3 N = normalize(GPassRT1.xyz);

	float3 l_IrradianceFromCache = SampleRadianceCache(l_ScreenCoord, l_Position_WorldSpace, N);
	if (any(isnan(l_IrradianceFromCache)))
		l_IrradianceFromCache = float3(0.0, 0.0, 0.0);

	// GI-1.0 §2.4.3 / SVGF (Schied et al. 2017) temporal accumulation.
	// Per-pixel moments history (E[L], E[L²], N) lets us compute TEMPORAL
	// variance — the probe's actual convergence rate — instead of the
	// shader-local SPATIAL variance [I.3d] used. Blend rate α = max(1/N,
	// α_min); N resets on disocclusion so newly-visible surfaces start at
	// α=1 (raw sample) and relax over subsequent frames.
	float l_CurrentDepth = length(l_Position_WorldSpace - g_Frame.camera_posWS.xyz);

	float2 l_Motion = in_opaquePassRT3.Load(int3(l_ScreenCoord, 0)).xy;
	int2 l_PrevCoord = int2(l_ScreenCoord) + int2(l_Motion);
	int2 l_Viewport = int2(g_Frame.viewportSize.xy);

	// Single-pixel reprojection for moments/history-count validity: only
	// the center tap drives "is my history usable at all." The 5x5
	// bilateral below is still used to denoise the color read; it's
	// retained here for parity with [I.3d] and will be dropped when
	// [I.3e.3] lands A-trous multi-stride filtering.
	bool l_ReprojectionValid = false;
	float l_PrevM1 = 0.0;
	float l_PrevM2 = 0.0;
	float l_PrevN = 0.0;
	if (all(l_PrevCoord >= int2(0, 0)) && all(l_PrevCoord < l_Viewport))
	{
		float4 l_CenterHistory = in_GIHistoryPrev.Load(int3(l_PrevCoord, 0));
		float l_CenterDepth = l_CenterHistory.a;
		if (l_CenterDepth > 0.0)
		{
			float l_DepthError = abs(l_CenterDepth - l_CurrentDepth) / max(l_CurrentDepth, EPSILON);
			if (l_DepthError <= 0.05)
			{
				float4 l_CenterMoments = in_MomentsPrev.Load(int3(l_PrevCoord, 0));
				if (l_CenterMoments.b > 0.0)
				{
					l_ReprojectionValid = true;
					l_PrevM1 = l_CenterMoments.r;
					l_PrevM2 = l_CenterMoments.g;
					l_PrevN = l_CenterMoments.b;
				}
			}
		}
	}

	float l_CurrentLuma = GetLuma(l_IrradianceFromCache);
	float l_CurrentLumaSq = l_CurrentLuma * l_CurrentLuma;

	float l_HistoryCount;
	float l_Alpha;
	float l_M1;
	float l_M2;
	if (l_ReprojectionValid)
	{
		l_HistoryCount = min(l_PrevN + 1.0, MAX_HISTORY_N);
		l_Alpha = max(1.0 / l_HistoryCount, MIN_TEMPORAL_ALPHA);
		l_M1 = lerp(l_PrevM1, l_CurrentLuma, l_Alpha);
		l_M2 = lerp(l_PrevM2, l_CurrentLumaSq, l_Alpha);
	}
	else
	{
		l_HistoryCount = 1.0;
		l_Alpha = 1.0;
		l_M1 = l_CurrentLuma;
		l_M2 = l_CurrentLumaSq;
	}

	// Pure per-pixel temporal EMA — the spatial filtering is now owned by
	// the GIATrous1/2/4 cascade downstream. Re-reading the center history
	// tap here is cheap; we already paid the latency for it during the
	// reprojection-validity check above.
	float3 l_DenoisedIrradiance;
	if (l_ReprojectionValid)
	{
		float3 l_HistoryColor = in_GIHistoryPrev.Load(int3(l_PrevCoord, 0)).rgb;
		l_DenoisedIrradiance = lerp(l_HistoryColor, l_IrradianceFromCache, l_Alpha);
	}
	else
	{
		l_DenoisedIrradiance = l_IrradianceFromCache;
	}

	out_GIHistory[l_ScreenCoord] = float4(l_DenoisedIrradiance, l_CurrentDepth);
	out_MomentsCurrent[l_ScreenCoord] = float4(l_M1, l_M2, l_HistoryCount, 0.0);
}
