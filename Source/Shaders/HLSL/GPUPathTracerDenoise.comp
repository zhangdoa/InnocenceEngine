// shadertype=hlsl
// GPUPathTracerDenoisePass kernel.
//
// Composition rule:
//   denoised = lerp(noisy, cached, saturate(sampleCount / cap))
//
// Reads the per-frame noisy radiance from GPUPathTracerPass::AccumBuffer
// and the persistent hash-grid value buffer (drained by the EMA filter
// pass). Hash key is derived from the writer-side (posWS, N) per pixel,
// supplied here via the per-pixel hit-info UAVs the PT raygen writes;
// cellSize uses the same HashGridCache_CellSize formula so the lookup
// key is bit-equal to what HashGridCache_Insert produced.
//
// Paper-port divergences from Capsaicin gi1.comp (see
// .alignments/TASK-77.1.3-hash-grid-cache-paper-port.md):
//   - Composition is a sampleCount-driven lerp with a hard kMaxCacheWeight
//     ceiling (Capsaicin uses a multi-tap reuse with separate variance
//     estimates). Phase-1 scope.
//   - Lookup site is screen-space primary hit; Capsaicin reads at
//     secondary vertices inside the bounce loop. Phase-2 closes the gap.
//   - Tangent-plane multi-tap read — partial closure of D1 (no cone-filter
//     mip walk yet, but adjacent-cell averaging at the read site smooths
//     the cell-boundary checkerboard the per-cell EMA mean produces when
//     projected onto neighbouring pixels). See D15 in the alignment artifact.

#include "common/common.hlsl"
#include "common/HashGridCache.hlsl"

struct ComputeInputType
{
    uint3 groupID         : SV_GroupID;
    uint3 groupThreadID   : SV_GroupThreadID;
    uint3 dispatchThreadID: SV_DispatchThreadID;
    uint  groupIndex      : SV_GroupIndex;
};

[[vk::binding(0, 0)]]
cbuffer PerFrameConstantBuffer : register(b0) { PerFrame_CB g_Frame; }

[[vk::binding(0, 1)]]
Texture2D<float4>                g_NoisyRadiance    : register(t0);
[[vk::binding(1, 1)]]
Texture2D<float4>                g_PrimaryHitPos    : register(t1);
[[vk::binding(2, 1)]]
Texture2D<float4>                g_PrimaryHitNormal : register(t2);

// Hash grid bound as RWStructuredBuffer (UAV) to match the writer's binding
// type — both hash buffers are persistently Accessibility::ReadWrite so
// cross-pass consumption uses the same view rather than a dedicated SRV
// transition. HashGridCache_Read does no atomics, just structured reads;
// the second include below resolves against these bindings. The denoise
// pass reads the persistent EMA-blended value buffer (the filter pass
// drained scratch into here on the same frame).
[[vk::binding(0, 2)]]
RWStructuredBuffer<uint>         g_HashGridKeys  : register(u0);
[[vk::binding(1, 2)]]
RWStructuredBuffer<HashGridCell> g_HashGridValue : register(u1);

#define HASHGRIDCACHE_HAS_BINDINGS
#define HASHGRIDCACHE_HAS_VALUE
#include "common/HashGridCache.hlsl"

[[vk::binding(2, 2)]]
RWTexture2D<float4> g_Denoised : register(u2);

// Sample-count cap for the lerp: at sampleCount >= cap the denoised pixel
// reaches kMaxCacheWeight cache reliance. Dropping below trades cache
// reliance for the noisy input proportionally. Matches HASHGRID_MAX_SAMPLE_COUNT
// — the persistent value buffer's sample count saturates there, so the
// lerp weight tracks the cell's accumulated history monotonically up to
// the kMaxCacheWeight ceiling.
static const float HashGridCache_DenoiseSampleCap = float(HASHGRID_MAX_SAMPLE_COUNT);

// Hard ceiling on the lerp weight. Without this, sampleCount saturation
// drives the noisy contribution to zero and any per-cell mean error (cell
// boundaries between neighbouring pixels under the flat-hash key shape)
// becomes a fully-baked tile pattern — the TASK-208 fix-up checkerboard.
// Holding 1 - kMaxCacheWeight of the noisy estimator at saturation keeps
// the per-frame high-frequency dither contribution alive, breaking up the
// boundary; the cache still does the bulk of variance reduction. 0.7 is
// the empirical landing point: 0.5 leaves visible noise above the cell
// floor, 0.85 starts to bake the checkerboard back in.
static const float HashGridCache_MaxCacheWeight = 0.7f;

[numthreads(8, 8, 1)]
void main(ComputeInputType input)
{
    uint2 pixel = input.dispatchThreadID.xy;
    uint2 viewport = uint2(g_Frame.viewportSize.xy);
    if (any(pixel >= viewport))
        return;

    float4 noisy = g_NoisyRadiance.Load(int3(pixel, 0));
    float4 hitPos4 = g_PrimaryHitPos.Load(int3(pixel, 0));
    float4 hitN4   = g_PrimaryHitNormal.Load(int3(pixel, 0));

    // Miss / sky pixels: writer set .w = 0. No cache key to look up;
    // pass the noisy radiance through unchanged. Same fallback the
    // composition rule degenerates to when sampleCount is zero.
    if (hitPos4.w < 0.5f)
    {
        g_Denoised[pixel] = noisy;
        return;
    }

    float3 posWS = hitPos4.xyz;
    float3 normal = normalize(hitN4.xyz);

    float depth = length(posWS - g_Frame.camera_posWS.xyz);
    float cellSize = HashGridCache_CellSize(depth, g_Frame.viewportSize.xy, g_Frame.p_original);

    // Tangent-plane basis for multi-tap read. Same construction shape as
    // GPUPathTracerRayGen.hlsl:159-161 (cosine-hemisphere sampling) — pick
    // a non-collinear "up" reference, build orthogonal tangent and
    // bitangent via cross products. The basis is screen-resolution-stable
    // (deterministic from normal alone) so neighbouring pixels on the same
    // surface read from the same neighbour cells.
    float3 up        = abs(normal.z) < 0.999f ? float3(0, 0, 1) : float3(1, 0, 0);
    float3 tangent   = normalize(cross(up, normal));
    float3 bitangent = cross(normal, tangent);

    // Multi-tap read — center cell + 4 tangent-plane neighbours offset by
    // ±0.5 cell size. Closes part of D1 (mip-cone filter): adjacent-cell
    // averaging at the read site smooths the cell-boundary checkerboard
    // the per-cell EMA mean produces when the hash key step-function
    // projects different cell means onto neighbouring screen pixels.
    // Capsaicin's gi1.comp:2306-2329 does an explicit 2D box filter inside
    // each tile; our flat-hash equivalent is this 5-tap neighbour read.
    // See D15 in .alignments/TASK-77.1.3-hash-grid-cache-paper-port.md.
    const float kNeighbourOffset = 0.5f; // half a cell — overlaps adjacent cells
    float3 offsets[5];
    offsets[0] = float3(0, 0, 0);
    offsets[1] = +kNeighbourOffset * cellSize * tangent;
    offsets[2] = -kNeighbourOffset * cellSize * tangent;
    offsets[3] = +kNeighbourOffset * cellSize * bitangent;
    offsets[4] = -kNeighbourOffset * cellSize * bitangent;

    float3 cachedSum   = float3(0.0f, 0.0f, 0.0f);
    float  weightSum   = 0.0f;
    uint   maxSampleCount = 0u;
    [unroll]
    for (int i = 0; i < 5; ++i)
    {
        float3 sampleRadiance = float3(0.0f, 0.0f, 0.0f);
        uint   sampleCount    = 0u;
        bool tapHit = HashGridCache_Read(posWS + offsets[i], normal, cellSize,
                                         sampleRadiance, sampleCount);
        if (tapHit && sampleCount > 0u)
        {
            cachedSum     += sampleRadiance;
            weightSum     += 1.0f;
            // sampleCount feeds the lerp weight downstream; track the
            // best-populated tap so the cache reliance reflects the cell
            // with the most accumulated history rather than the average
            // (a sparse neighbour shouldn't drag the cache weight down).
            maxSampleCount = max(maxSampleCount, sampleCount);
        }
    }

    float3 result;
    if (weightSum > 0.0f)
    {
        float3 cached = cachedSum / weightSum;
        float  w      = saturate(float(maxSampleCount) / HashGridCache_DenoiseSampleCap)
                      * HashGridCache_MaxCacheWeight;
        result = lerp(noisy.rgb, cached, w);
    }
    else
    {
        // All taps missed. The hash entries haven't been written yet
        // (first frames on this pixel, or probe-chain overflow evicted
        // them). Fall back to the raw noisy frame — identical to lerp at
        // sampleCount = 0.
        result = noisy.rgb;
    }

    g_Denoised[pixel] = float4(result, 1.0f);
}
