// shadertype=hlsl

// Minimal LightPass: sun as a directional light, attenuated by SunShadowRTPass's
// per-pixel RT visibility (R8, 0=shadowed, 1=lit), + a small flat ambient.
// Degraded stand-in for lightPass.comp (no radiance-cache GI or tiled point
// lights yet). Reuses DecodeGBuffer + AccumulateLightContribution from
// common/lightPassCommon.hlsl.

#include "common/common.hlsl"

struct ComputeInputType
{
	uint3 dispatchThreadID : SV_DispatchThreadID;
};

[[vk::binding(0, 0)]]
cbuffer PerFrameConstantBuffer : register(b0)
{
	PerFrame_CB g_Frame;
}

[[vk::binding(0, 1)]]
Texture2D in_opaquePassRT0 : register(t0);
[[vk::binding(1, 1)]]
Texture2D in_opaquePassRT1 : register(t1);
[[vk::binding(2, 1)]]
Texture2D in_opaquePassRT2 : register(t2);
[[vk::binding(3, 1)]]
Texture2D in_BRDFLUT : register(t3);
[[vk::binding(4, 1)]]
Texture2D in_BRDFMSLUT : register(t4);
[[vk::binding(5, 1)]]
Texture2D<float> in_SunShadowRTVisibility : register(t5);
[[vk::binding(0, 2)]]
SamplerState in_samplerPoint : register(s0);
[[vk::binding(0, 3)]]
RWTexture2D<float4> out_Luminance : register(u0);

#include "common/BSDF.hlsl"
#include "common/lightPassCommon.hlsl"

// Flat ambient fraction of albedo applied to all geometry so shadowed
// regions remain readable without the (excluded) radiance-cache GI.
static const float SIMPLE_AMBIENT_INTENSITY = 0.05;

[numthreads(8, 8, 1)]
void main(ComputeInputType input)
{
	uint2 l_ScreenCoord = input.dispatchThreadID.xy;
	out_Luminance[l_ScreenCoord] = float4(0.0, 0.0, 0.0, 0.0);

	float3 l_PositionWS;
	float3 l_NormalWS;
	MaterialAttributes l_Material;
	if (!DecodeGBuffer(in_opaquePassRT0, in_opaquePassRT1, in_opaquePassRT2, l_ScreenCoord, l_PositionWS, l_NormalWS, l_Material))
	{
		DeviceMemoryBarrier();
		return;
	}

	float3 l_V = normalize(g_Frame.camera_posWS.xyz - l_PositionWS);
	float3 l_L = normalize(g_Frame.sun_direction.xyz);

	float3 l_SunDirect = float3(0.0, 0.0, 0.0);
	float3 l_SunIndirectSeed = float3(0.0, 0.0, 0.0);
	AccumulateLightContribution(
		in_BRDFLUT, in_BRDFMSLUT, in_samplerPoint,
		l_Material, l_V, l_NormalWS, l_L,
		g_Frame.sun_illuminance.xyz, 1.0,
		l_SunDirect, l_SunIndirectSeed);

	// Sun-shadow visibility (SunShadowRTPass, R8: 0=shadowed, 1=lit). Until the
	// TLAS is ready the pass is skipped and this reads the cleared buffer (0 =
	// shadowed) for the first frames, then resolves once tracing begins.
	float l_SunVisibility = in_SunShadowRTVisibility.Load(int3(l_ScreenCoord, 0));
	l_SunDirect *= l_SunVisibility;

	float3 l_Ambient = l_Material.m_Albedo * SIMPLE_AMBIENT_INTENSITY;

	out_Luminance[l_ScreenCoord] = float4(l_SunDirect + l_Ambient, 1.0);
	DeviceMemoryBarrier();
}
