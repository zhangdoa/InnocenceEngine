// shadertype=hlsl
#include "common/RadianceCacheCommon.hlsl"
#include "RayTracingTypes.hlsl"

struct ComputeInputType
{
    uint3 groupID : SV_GroupID;
    uint3 groupThreadID : SV_GroupThreadID;
    uint3 dispatchThreadID : SV_DispatchThreadID;
    uint groupIndex : SV_GroupIndex;
};

[[vk::binding(0, 0)]]
cbuffer PerFrameConstantBuffer : register(b0)
{
    PerFrame_CB g_Frame;
}

[[vk::binding(0, 1)]]
Texture2D in_opaquePassRT0 : register(t0); // World Space Position (RGB)
[[vk::binding(1, 1)]]
Texture2D in_opaquePassRT1 : register(t1); // World Space Normal (RGB)
[[vk::binding(2, 1)]]
Texture2D in_opaquePassRT3 : register(t2); // Motion Vector (RG)

[[vk::binding(3, 1)]]
Texture2D<float4> in_RadianceCacheResults_Prev : register(t3);

[[vk::binding(4, 1)]]
Texture2D<float4> in_ProbePosition : register(t4);

[[vk::binding(5, 1)]]
Texture2D<float4> in_ProbeNormal : register(t5);

[[vk::binding(0, 2)]]
RWTexture2D<float4> in_RadianceCacheResults : register(u0);

// Heuristics for temporal stability. NORMAL_THRESHOLD, DEPTH_THRESHOLD and
// the confidence bounds are local to the reprojection's validity decision;
// the spatial scale (plane / distance) comes from the unified Algorithm 6
// AdaptiveCellSize so reprojection, sampling, and filter agree on what
// counts as "same surface".
static const float NORMAL_THRESHOLD = 0.9;
static const float DEPTH_THRESHOLD = 0.1;
static const float MIN_CONFIDENCE = 0.1;
static const float MAX_CONFIDENCE = 0.95;

float CalculateReprojectionConfidence(
    float3 currentPos, float3 currentNormal,
    float3 prevPos, float3 prevNormal,
    float2 motionVector, float depthDiff,
    float cellSize)
{
    float confidence = 1.0;

    float distancePenalty = distance(currentPos, prevPos) / max(cellSize, EPSILON);
    confidence *= exp(-distancePenalty * distancePenalty);

    float normalSimilarity = max(0.0, dot(currentNormal, prevNormal));
    confidence *= normalSimilarity;

    float motionMagnitude = length(motionVector) / g_Frame.viewportSize.x;
    confidence *= exp(-motionMagnitude * 10.0);

    confidence *= exp(-depthDiff * depthDiff / (DEPTH_THRESHOLD * DEPTH_THRESHOLD));

    return clamp(confidence, MIN_CONFIDENCE, MAX_CONFIDENCE);
}

float4 TemporalFilter(float4 currentSample, float4 historySample, float confidence)
{
    // High confidence = valid reprojection = weight history heavily to accumulate samples.
    // Low confidence = disocclusion or fast motion = favor current frame.
    float blendRate = lerp(0.95, 0.1, confidence);
    float4 result = lerp(historySample, currentSample, blendRate);
    result.rgb = max(result.rgb, float3(0.0, 0.0, 0.0));
    return result;
}

// Use groupshared memory for atomic operations
groupshared uint sharedReprojectionScore;
groupshared float sharedConfidence;

[numthreads(8, 8, 1)]
void main(ComputeInputType input)
{
    uint2 screenCoord = input.dispatchThreadID.xy;
    uint2 screenCoord_Probe = (screenCoord / 8) * 8;

    // --- Classify this thread (no early return before barriers) ---
    bool isSky = in_opaquePassRT0.Load(int3(screenCoord, 0)).w == 0.0f;

    float3 positionWS = float3(0, 0, 0);
    float2 motionVector = float2(0, 0);
    int2 prevScreenCoord = int2(0, 0);
    uint2 prevScreenCoord_Probe = uint2(0, 0);
    bool withinBounds = false;
    float threadConfidence = 0.0;
    bool earlyExit = isSky;

    if (!isSky)
    {
        positionWS = in_opaquePassRT0.Load(int3(screenCoord, 0)).xyz;
        motionVector = in_opaquePassRT3.Load(int3(screenCoord, 0)).xy;
        prevScreenCoord = int2(screenCoord) + int2(motionVector);
        withinBounds = all(prevScreenCoord >= int2(0, 0)) && all(prevScreenCoord < int2(g_Frame.viewportSize.xy));

        if (!withinBounds)
            earlyExit = true;

        if (withinBounds)
        {
            uint2 prevProbe = (prevScreenCoord / 8) * 8;
            prevProbe.x += (prevScreenCoord.x - (int)prevProbe.x) > 4 ? 8 : 0;
            prevProbe.y += (prevScreenCoord.y - (int)prevProbe.y) > 4 ? 8 : 0;
            prevScreenCoord_Probe = prevProbe;
        }
    }

    // --- Shared memory initialisation (ALL threads participate, no early return) ---
    if (input.groupIndex == 0)
    {
        sharedReprojectionScore = 0xFFFFFFFF; // Max uint = worst score
        sharedConfidence = 0.0;
    }

    GroupMemoryBarrierWithGroupSync(); // Barrier 1: shared memory ready

    // --- Compute per-thread reprojection score (only for non-exiting threads) ---
    if (!earlyExit)
    {
        uint2 prevScreenCoord_ProbeSpace = prevScreenCoord_Probe / 8;
        float3 prevPositionWS_Probe = in_ProbePosition.Load(int3(prevScreenCoord_ProbeSpace, 0)).xyz;
        float3 prevNormal_Probe = normalize(in_ProbeNormal.Load(int3(prevScreenCoord_ProbeSpace, 0)).xyz);
        float3 normalWS = normalize(in_opaquePassRT1.Load(int3(screenCoord, 0)).xyz);

        float plane_dist = abs(dot(prevPositionWS_Probe - positionWS, normalWS));
        float normal_check = dot(prevNormal_Probe, normalWS);

        float currentDepth = length(positionWS - g_Frame.camera_posWS.xyz);
        float prevDepth = length(prevPositionWS_Probe - g_Frame.camera_posWS.xyz);
        float depthDiff = abs(currentDepth - prevDepth);

        // Unified adaptive cell size (Algorithm 6). Threshold both the
        // plane-distance acceptance and the confidence scoring by the same
        // scale so the "can I reuse this probe?" decision here and the
        // filter's "is this neighbor usable?" decision later are aligned.
        float cellSize = max(AdaptiveCellSize(currentDepth, g_Frame.viewportSize.xy, g_Frame.p_original), 0.1);

        if (plane_dist < cellSize &&
            normal_check > NORMAL_THRESHOLD &&
            depthDiff < DEPTH_THRESHOLD)
        {
            float dist = distance(prevPositionWS_Probe, positionWS);

            threadConfidence = CalculateReprojectionConfidence(
                positionWS, normalWS,
                prevPositionWS_Probe, prevNormal_Probe,
                motionVector, depthDiff, cellSize);

            // Score by distance; lower 16 bits carry groupIndex for winner identification
            uint distScore = (uint)(saturate(dist / cellSize) * 65535.0);
            uint candidateScore = (distScore << 16) | input.groupIndex;

            InterlockedMin(sharedReprojectionScore, candidateScore);
        }
    }

    GroupMemoryBarrierWithGroupSync(); // Barrier 2: InterlockedMin complete

    // Exactly one thread (the winner) writes confidence — race-free because each
    // thread has a unique groupIndex and only one can match the stored lower 16 bits.
    if (!earlyExit && (sharedReprojectionScore & 0xFFFF) == input.groupIndex)
    {
        sharedConfidence = threadConfidence;
    }

    GroupMemoryBarrierWithGroupSync(); // Barrier 3: sharedConfidence written

    // --- Apply result (all barriers done; early exits are safe below) ---
    if (earlyExit)
    {
        // Sky or out-of-bounds: clear probe tile (thread 0 per group covers all 64 pixels)
        if (input.groupIndex == 0)
        {
            for (uint i = 0; i < 8; i++)
            {
                for (uint j = 0; j < 8; j++)
                {
                    in_RadianceCacheResults[screenCoord_Probe + uint2(i, j)] = float4(0, 0, 0, 0);
                }
            }
        }
        DeviceMemoryBarrier();
        return;
    }

    uint bestProbeGroupIndex = sharedReprojectionScore & 0xFFFF;
    float reprojectionConfidence = sharedConfidence;

    if (input.groupIndex == bestProbeGroupIndex && reprojectionConfidence > MIN_CONFIDENCE)
    {
        for (uint i = 0; i < 8; i++)
        {
            for (uint j = 0; j < 8; j++)
            {
                uint2 currentPixel = screenCoord_Probe + uint2(i, j);
                uint2 prevPixel = prevScreenCoord_Probe + uint2(i, j);

                float4 currentSample = in_RadianceCacheResults[currentPixel];
                float4 historySample = in_RadianceCacheResults_Prev[prevPixel];

                float4 filteredSample = TemporalFilter(currentSample, historySample, reprojectionConfidence);

                in_RadianceCacheResults[currentPixel] = filteredSample;
            }
        }
    }
    else if (input.groupIndex == 0)
    {
        // No valid reprojection found - use current sample with reduced confidence
        for (uint i = 0; i < 8; i++)
        {
            for (uint j = 0; j < 8; j++)
            {
                uint2 currentPixel = screenCoord_Probe + uint2(i, j);
                float4 currentSample = in_RadianceCacheResults[currentPixel];

                // Apply stability clamping
                currentSample.rgb = max(currentSample.rgb, float3(0.0, 0.0, 0.0));

                in_RadianceCacheResults[currentPixel] = currentSample;
            }
        }
    }

    DeviceMemoryBarrier();
}
