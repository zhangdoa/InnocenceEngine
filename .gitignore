# Build binaries
/Bin
/Build

# clangd index — regenerated by Scripts/RegenClangdIndex.ps1.
# Machine-specific (full paths to compiler / external includes).
/compile_commands.json
/.cache/clangd

# Dynamic linking export headers
/Source/Engine/Export
/Source/Game/Export

# Third-party headers and libraries
/Source/External/Include

# For macOS
\.DS_Store
/Source/Engine/Platform/MacMain/build

# For Xcode
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# For Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio Code
.history/

# Intermediate code and assets
/Source/Engine/Common/Config.h
*.refl

# Generated shader binaries
*.spv
*.dxil

# Data folders — track Engine and project data, ignore generated
/Data/*
!/Data/Engine/
!/Data/ExampleProject/

# Per-user runtime config emitted by the engine (TASK-21 tweaks panel).
# The schema is defined in Source/ExampleProject/LogicClient/Player.inl;
# the file is regenerated with engine defaults whenever it's missing.
/Data/ExampleProject/Configs/

# Large binary assets
/OriginalAssets/*

# For Qt
/Source/Editor/qdarkstyle/
/Source/Editor/Editor.pro.user

#For ImGui
/Source/Engine/ThirdParty/ImGui/*
!/Source/Engine/ThirdParty/ImGui/CMakeLists.txt

#Packaged files
/Package/*

# Transient build/test output (never commit these)
build*.log
build*.txt
test*.log
test*.txt
gpu_test*.txt
*.Log

# Playwright (Editor-Next) per-run artefacts
/Source/Editor-Next/test-results/

# Claude Code runtime lockfile
/.claude/scheduled_tasks.lock

.worktrees/

# Alignment auxiliary snapshots (third-party reference source, capture dumps, etc.).
# Owned by software-architect; conventions in .alignments/CLAUDE.md.
/.alignments/_*/

